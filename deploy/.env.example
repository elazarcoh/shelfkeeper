# My Library on the Pi: the Komodo stack's Environment (Komodo writes it as deploy/.env). README → Running on a server.

# Letters, digits and dashes only: it is embedded in a connection URL. Generate one with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# 32 random bytes, base64. It seals saved source logins and is copied into every backup. Generate one with:
#   openssl rand -base64 32
# Keep it: a restore re-seals logins to whatever key is set here, but changing it by hand makes saved logins unreadable.
APP_SECRET_KEY=

# The URL prefix the app is served under, e.g. /mylibrary for http://192.168.1.50/mylibrary/ (README → Serving under a
# sub-path). Baked into the image when it is built: change it, then redeploy so the image is rebuilt. / = the root.
BASE_PATH=/

# A loopback-only (127.0.0.1) host port, for local checks on the Pi itself (curl http://127.0.0.1:8080/health).
# nginx does not use it: it reaches the app as `my-library:3000` over the `shared` Docker network.
APP_PORT=8080

# Host folder holding postgres/ and assets/. Absolute, so the start-up checks can compare it with the others.
# Moving to an SSD means changing only this (README → Move DATA_DIR).
DATA_DIR=/srv/appdata/komodo/stacks/my-library/data

# Host folder for backups. It must not be inside DATA_DIR or a protected path.
BACKUP_DIR=/Media/Backup/my-library

# Colon-separated host paths the app must never write to.
PROTECTED_PATHS=/Media/Media:/Media/Downloads

# When the scheduled backup runs (cron: minute hour day month weekday, in TZ). Admin → Backups can override it.
BACKUP_SCHEDULE=0 3 * * *

# Optional: a copy of every backup in Backblaze B2, encrypted on the Pi by restic (README → Cloud backup).
# Leave RESTIC_REPOSITORY empty to keep backups on this machine only.
#   RESTIC_REPOSITORY=s3:https://<bucket endpoint, e.g. s3.eu-central-003.backblazeb2.com>/<bucket>/my-library
# RESTIC_PASSWORD encrypts the copies: save it in a password manager. Without it nobody can read them, ever.
# The AWS_* pair is the B2 application key (keyID, applicationKey) with read and write access to that bucket.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# true once the app is reached over HTTPS (a reverse proxy with a certificate): sign-in cookies are then sent over
# HTTPS only. Keep false while any plain-http address (http://192.168.1.50/…) is still used to sign in.
COOKIE_SECURE=false
# Optional: the National Library of Israel's search API key, for looking up scanned ISBNs (README → Adding books from
# a shelf). A free personal key: https://api2.nli.org.il/signup/. Empty = ISBNs are looked up on Open Library only.
NLI_API_KEY=
# Time zone for the backup schedule and the logs.
TZ=Asia/Jerusalem
