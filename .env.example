# Letters, digits and dashes only — it is embedded in a connection URL.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Port the app is published on.
APP_PORT=8080
# Set to true when the app is served over HTTPS (e.g. behind a reverse proxy).
COOKIE_SECURE=false
# 32 random bytes, base64 — encrypts source credentials (e.g. the Audiobookshelf API token). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it: changing it makes stored source credentials unreadable (re-enter them in Admin → Sources).
APP_SECRET_KEY=
